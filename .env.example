# If true, forwards every received message to your FastAPI server
FORWARD_TO_WEBHOOK=false

# Your FastAPI server URL (only used if FORWARD_TO_WEBHOOK=true)
WEBHOOK_URL=http://localhost:8000/webhook/whatsapp

# Google Cloud Storage bucket name (leave empty to skip GCS upload)
GCS_BUCKET_NAME=your-gcs-bucket-name

# Cloud SQL (PostgreSQL) connection string (leave empty to skip DB storage)
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# For Cloud SQL with Unix socket: postgresql://USER:PASSWORD@/DATABASE?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://user:password@localhost:5432/aeris
